{
  "name": "@getengram/mcp-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "smoke:bundle": "node scripts/boot-bundle.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply engram-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply engram-db --remote",
    "seed": "node --loader tsx scripts/seed.ts",
    "seed:demo": "node --loader tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@getengram/db": "workspace:*",
    "@getengram/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "hono": "^4.13.11",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260423.1",
    "@getengram/sdk": "workspace:*",
    "@types/node": "^20.19.39",
    "miniflare": "4.20260421.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.84.1"
  }
}
